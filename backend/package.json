{
  "name": "interview-assessment-backend",
  "version": "1.0.0",
  "description": "Production-grade Interview Assessment Platform API (Express + PostgreSQL + JWT)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/db/migrate.js && node src/server.js",
    "dev": "node scripts/free-port.js && node --watch src/server.js",
    "test:auth:config": "vitest run tests/integration/config --config vitest.config.config.js",
    "test:auth:db": "vitest run tests/integration/auth tests/integration/student tests/integration/institution tests/integration/admin tests/integration/business --config vitest.config.db.js",
    "test:auth": "npm run test:auth:config && npm run test:auth:db",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:sync-catalogue": "node scripts/sync-catalogue-series.mjs",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-appwrite": "^27.0.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.4",
    "pg": "^8.12.0",
    "razorpay": "^2.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
