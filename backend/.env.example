# Server Configuration
PORT=5000
NODE_ENV=development # Set to production in production environment
CLIENT_URL=http://localhost:5173,https://edvedum.com,https://www.edvedum.com
INVITE_BASE_URL=https://edvedum.com

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_platform
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=interview_platform

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=30d

# PhonePe Payment Gateway (Standard Checkout v2)
# Obtain these credentials from the PhonePe Merchant Portal (https://business.phonepe.com)
PHONEPE_CLIENT_ID=your_phonepe_client_id_here
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret_here
PHONEPE_CLIENT_VERSION=1
MERCHANT_ID=your_phonepe_merchant_id_here
PHONEPE_ENV=PRODUCTION # Explicitly set to PRODUCTION for live transactions or SANDBOX for pre-prod
PHONEPE_MERCHANT_HOST_URL=https://edvedum.com

# PhonePe Webhook Authentication
# Configure the same username and password in the PhonePe Merchant Dashboard under Webhook / Callback settings:
# Webhook Callback URL: https://edvedum.com/api/payments/phonepe/webhook
PHONEPE_WEBHOOK_USERNAME=your_phonepe_webhook_username_here
PHONEPE_WEBHOOK_PASSWORD=your_phonepe_webhook_password_here

# Legacy Gateway (Optional Fallback)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EDVEDUM Academy <noreply@edvedum.com>

# Cloudinary (Media / E-books / Brochures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# AI & LLM Integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
