{
  "uid": "edvedum-load-testing",
  "title": "Edvedum load testing",
  "description": "Dark dashboard for Prometheus external_labels project=edvedum and environment=load-testing. API latency and error panels use the same formulas as the recording rules, with scenario, api, status, and instance filters.",
  "tags": ["edvedum", "load-testing"],
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": false,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total, scenario)",
        "query": "label_values(k6_http_reqs_total, scenario)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "api",
        "label": "API",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total, api)",
        "query": "label_values(k6_http_reqs_total, api)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "status",
        "label": "Status",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total, status)",
        "query": "label_values(k6_http_reqs_total, status)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up, instance)",
        "query": "label_values(up, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API Performance",
      "description": "Request timing and throughput for the selected scenario, API, status, and instance. Latency uses the recording-rule formulas.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average Response Time",
      "description": "Measures the mean k6 request duration for the current filters. Unit is seconds. Same formula as recording rule avg_api_latency. A rising mean means the API is slowing down for everyone, not only the tail.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum(rate(k6_http_req_duration_seconds_sum{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m])) / clamp_min(sum(rate(k6_http_req_duration_seconds_count{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m])), 1e-9)) or ((sum(rate(k6_http_req_duration_seconds_sum{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])) / clamp_min(sum(rate(k6_http_req_duration_seconds_count{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])), 1e-9)) unless sum(rate(k6_http_req_duration_seconds_count{instance=~\".+\"}[1m])))", "legendFormat": "avg" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15, "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95",
      "description": "Measures the 95th percentile request duration for the current filters. Unit is seconds. Same formula as recording rule p95_api_latency. The prepared alert fires above 2 seconds. This shows the slow experience most students actually hit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m]))) or histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m])))) or ((histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])))) unless sum(rate(k6_http_req_duration_seconds_count{instance=~\".+\"}[1m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "P99",
      "description": "Measures the 99th percentile request duration for the current filters. Unit is seconds. Same formula as recording rule p99_api_latency. This is the tail. A high P99 with a calm P95 means a few requests are stalling.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m]))) or histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_seconds_bucket{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m])))) or ((histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_seconds_bucket{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])))) unless sum(rate(k6_http_req_duration_seconds_count{instance=~\".+\"}[1m])))", "legendFormat": "p99" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests Per Second",
      "description": "Measures completed HTTP requests per second for the current filters. Unit is requests per second. Same formula as recording rule requests_per_second. Use it to see whether load is steady or the students have stopped calling the API.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum(rate(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\",instance=~\"${instance:regex}\"}[1m]))) or (sum(rate(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])) unless sum(rate(k6_http_reqs_total{instance=~\".+\"}[1m])))", "legendFormat": "rps" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Server Health",
      "description": "Node Exporter host health for the selected instance. Scenario, API, and status filters hide this row when they match no k6 series.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Measures non-idle CPU across the selected instance. Unit is percent. The prepared alert fires above 85 percent. Sustained CPU means the host cannot keep up with answer saves.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m])))) or ((100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"${instance:regex}\"}[1m])))) unless avg(rate(node_cpu_seconds_total{scenario=~\".+\"}[1m])) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RAM Usage",
      "description": "Measures memory in use as total minus available. Unit is percent. The prepared alert fires above 90 percent. Low available memory leads to swapping and slower exam requests.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"} / node_memory_MemTotal_bytes{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}))) or ((100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"${instance:regex}\"} / node_memory_MemTotal_bytes{instance=~\"${instance:regex}\"}))) unless count(node_memory_MemAvailable_bytes{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk Usage",
      "description": "Measures how full each real filesystem is. Unit is percent. The prepared alert fires above 90 percent. A full disk stops Prometheus, logs, and Node Exporter textfiles.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|ramfs\",instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|ramfs\",instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}))) or ((100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|ramfs\",instance=~\"${instance:regex}\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|ramfs\",instance=~\"${instance:regex}\"}))) unless count(node_filesystem_size_bytes{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}} {{mountpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Measures disk bytes read and written per second on the selected instance. Unit is bytes per second. High write rate during the test usually means database or log pressure.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum by (instance) (rate(node_disk_read_bytes_total{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or (sum by (instance) (rate(node_disk_read_bytes_total{instance=~\"${instance:regex}\"}[1m])) unless count(node_disk_read_bytes_total{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}} read" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum by (instance) (rate(node_disk_written_bytes_total{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or (sum by (instance) (rate(node_disk_written_bytes_total{instance=~\"${instance:regex}\"}[1m])) unless count(node_disk_written_bytes_total{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}} write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network In",
      "description": "Measures bytes received per second, excluding loopback, for the selected instance. Unit is bytes per second. Inbound spikes should line up with students loading question papers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|Loopback\",instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or (sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|Loopback\",instance=~\"${instance:regex}\"}[1m])) unless count(node_network_receive_bytes_total{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Network Out",
      "description": "Measures bytes sent per second, excluding loopback, for the selected instance. Unit is bytes per second. Outbound traffic is the question paper and result payloads leaving the host.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|Loopback\",instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}[1m]))) or (sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|Loopback\",instance=~\"${instance:regex}\"}[1m])) unless count(node_network_transmit_bytes_total{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Active TCP Connections",
      "description": "Measures established TCP connections on the selected instance. Unit is connections. A climb that does not fall means clients are holding sockets open.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(node_netstat_Tcp_CurrEstab{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"} or node_sockstat_TCP_inuse{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) or ((node_netstat_Tcp_CurrEstab{instance=~\"${instance:regex}\"} or node_sockstat_TCP_inuse{instance=~\"${instance:regex}\"}) unless count(node_netstat_Tcp_CurrEstab{scenario=~\".+\"} or node_sockstat_TCP_inuse{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Node.js RSS Memory",
      "description": "Measures the Node.js process resident set size from edvedum_process_rss_bytes. Unit is bytes. RSS growth during the test means the process is holding more memory than it releases.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(edvedum_process_rss_bytes{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) or (edvedum_process_rss_bytes{instance=~\"${instance:regex}\"} unless count(edvedum_process_rss_bytes{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0) or (edvedum_process_rss_bytes unless count(edvedum_process_rss_bytes{instance=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Event Loop Delay",
      "description": "Measures Node.js event-loop lag from nodejs_eventloop_lag_seconds. Unit is seconds. The prepared alert fires above 200 milliseconds. Lag means the process is too busy to accept the next answer save promptly.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(nodejs_eventloop_lag_seconds{instance=~\"${instance:regex}\",scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) or (nodejs_eventloop_lag_seconds{instance=~\"${instance:regex}\"} unless count(nodejs_eventloop_lag_seconds{scenario=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0) or (nodejs_eventloop_lag_seconds unless count(nodejs_eventloop_lag_seconds{instance=~\".+\"}) unless count(k6_http_reqs_total{scenario=~\"${scenario:regex}\",api=~\"${api:regex}\",status=~\"${status:regex}\"}) == 0)", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Student Behaviour",
      "description": "How many virtual students in each behaviour finished their paper. Counts respect the scenario filter and blank out when api, status, or instance filters exclude the series.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "type": "stat",
