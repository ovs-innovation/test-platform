# Copy to load-testing/.env and replace the placeholder values.
# These files do not load .env for k6. Export the variables in the shell before k6 run.
# Playwright reads load-testing/.env when that file exists, and keeps variables already set in the shell.

BASE_URL=http://localhost:5000
STUDENT_EMAIL=student@example.com
STUDENT_PASSWORD=replace-me
ASSESSMENT_ID=0

# k6 only. First run stays small.
VUS=5
DURATION=30s

# Local Prometheus remote-write receiver. Prometheus is not started by these files.
K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write
